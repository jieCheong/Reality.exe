# Fill these in privately. All three LiveKit values must belong to one project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# No OpenAI / Deepgram / Cartesia API key is needed: use LiveKit Inference.
# Set yes ONLY after checking the existing project is free Build, has credits,
# and has no paid billing enabled. This is an attestation, not a billing check.
LIVEKIT_FREE_BUILD_CONFIRMED=no

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-video

# Optional: save at most five distinct caller-camera JPEGs per job, locally.
DEBUG_CALLER_FRAMES=no

# Optional local game mode. Off until explicitly enabled; no provider key in Node.
ENABLE_GAME=no
VISION_SERVICE_URL=http://127.0.0.1:8765
# groq rejects mock responses; mock explicitly labels all HUD/voice output as mock.
VISION_MODE=groq

# Existing LiveKit Inference voice remains the default.
TTS_PROVIDER=livekit
TTS_FALLBACK_PROVIDER=livekit
# Optional direct ElevenLabs TTS: requires explicit approval and your own account.
# Installing the plugin does not authorize requests or establish free usage.
ELEVENLABS_REQUESTS_APPROVED=no
ELEVEN_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVEN_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID
ELEVEN_MODEL=eleven_flash_v2_5

# Controlled test catalog only; never changes teammate-owned production themes.
# Requires ENABLE_GAME=yes too. Leave off for normal operation.
GAME_TEST_MODE=no

# Temporary synthetic outgoing video pattern; leave off outside diagnostics.
HUD_VIDEO_DIAGNOSTIC=no

# Optional native HUD layouts: default=540x960; juan-original=540x1170; landscape-test=640x360;
# rotated-ccw / rotated-cw = the portrait HUD turned into a 960x540 frame so FaceTime shows it upright and
# full-screen on a portrait phone. If the HUD comes out upside down, switch ccw <-> cw.
# juan-themes = Juan's three worlds (Space, Odyssey, Backrooms); after the greeting the child picks one.
# juan-themes-rotated-ccw / -cw = the same, quarter-turned for upright full-screen FaceTime.
HUD_VIDEO_PROFILE=juan-themes-rotated-ccw

# Parent-authored routine (Jie's routine mode); requires ENABLE_GAME=yes. Empty keeps fixed missions.
# Kids' 9-step morning routine: examples/routines/kids-morning.json
# Morning + night: the child says "good morning" or "good night" to pick one.
ROUTINE_MORNING_FILE=examples/routines/kids-morning.json
ROUTINE_NIGHT_FILE=examples/routines/kids-night.json
# Or a single routine that starts right away:
# ROUTINE_FILE=examples/routines/kids-morning.json
